docRoot                   $VH_ROOT/html/
vhDomain                  ${domain}
vhAliases                 www.${domain}, origin.${domain}
enableGzip                1
enableBr                  1

errorlog $VH_ROOT/logs/error.log {
  useServer               0
  logLevel                ERROR
  rollingSize             10M
  keepDays                7
  compressArchive         1
}

accesslog $VH_ROOT/logs/access.log {
  useServer               0
  logFormat               "%v %h %l %u %t \"%r\" %>s %b"
  logHeaders              7
  rollingSize             10M
  keepDays                7
  compressArchive         1
}

index  {
  useServer               0
  indexFiles              index.php, index.html
  autoIndex               0
}

rewrite  {
  enable                  1
  autoLoadHtaccess        1
%{ if origin_secret != "" ~}
  # Refuse anything that did not come through one of this stack's CloudFront
  # distributions, which add the origin secret header. The instance's own
  # requests - wp-cron, the bootstrap's health check, debugging on the box -
  # arrive over the loopback interface and are let through.
  rules                   <<<END_rules
RewriteCond %%{REMOTE_ADDR} !^127\.0\.0\.1$
RewriteCond %%{HTTP:X-Origin-Verify} !^${origin_secret}$
RewriteRule ^ - [F]
  END_rules
%{ endif ~}
}
